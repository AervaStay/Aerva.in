      "maxDuration": 60,
      "includeFiles": "node_modules/pdfkit/js/data/**"
    },
    "api/get-pending-listings.js": {
      "maxDuration": 60
    },
    "api/blob-upload.js": {
      "maxDuration": 60
    },
